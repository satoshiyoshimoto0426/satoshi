# =============================================================================
# 環境変数サンプル(制度改正ウォッチ & 公式LINE毎朝配信システム)
#
# 使い方:  cp .env.example .env  してから値を埋める。.env は .gitignore 済み。
#
# ★★ ここに書かれている値はすべてダミーです。実際の値は絶対にコミットしないでください。★★
#   本番の秘密情報は Secret Manager に保管し、Cloud Run Jobs の secret 参照で
#   実行時に環境変数へ注入します(詳細設計書 §11 / 要件定義書 NFR-03)。
#   誤ってコミットした場合は、値を書き換えるだけでなく必ずキーをローテーションしてください。
# =============================================================================

# -----------------------------------------------------------------------------
# 秘密情報(ローカル検証以外では .env に置かず Secret Manager から注入する)
# -----------------------------------------------------------------------------

# LINE チャネルアクセストークン。チャネル ID を大文字にした LINE_TOKEN_<ID> を探し、
# 見つかればチャネル定義の lineTokenSecret より優先される(契約: src/context.ts)。
# チャネルを増やしたら LINE_TOKEN_<新ID大文字> を同じ形式で追加する(NFR-09)。
LINE_TOKEN_AI_RESKILL=dummy-line-channel-access-token-ai-reskill
LINE_TOKEN_WELFARE=dummy-line-channel-access-token-welfare

# Anthropic API キー。@anthropic-ai/sdk が既定でこの名前を読む(コード側で値を参照しない)。
ANTHROPIC_API_KEY=sk-ant-dummy-000000000000000000000000000000000000

# Slack Incoming Webhook URL(運用通知先。詳細設計書 §12)。
# URL 自体が秘密なのでログには出力されない(logger の redact 対象)。
# 未設定なら Slack へは送らずログ出力のみになる。
# 形式: https://hooks.slack.com/services/<チームID>/<チャンネルID>/<トークン>
# ここにはダミーであっても実物と同じ形の値を書かないこと
# (GitHub のシークレット検知に引っかかり push できなくなる)。
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# 実行時設定(src/config/runtime.ts。値は既定値。コメントは既定値と意味)
# -----------------------------------------------------------------------------

# GCP プロジェクト ID。未設定なら実行環境の既定認証情報に任せる(既定: 未設定)。
GCP_PROJECT_ID=my-gcp-project

# Firestore のデータベース ID(既定: (default) )。
FIRESTORE_DATABASE_ID=(default)

# データストアの種類。firestore | memory(既定: firestore)。
# ローカル検証やドライランでは memory にすると外部接続なしで通し実行できる(NFR-05)。
STORE_KIND=firestore

# 分類・要約に使う Claude モデル(既定: claude-opus-5)。
ANTHROPIC_MODEL=claude-opus-5

# User-Agent。NFR-07 により連絡先を必ず明記する。運用チームの実アドレスに変更すること。
USER_AGENT=SeidoWatchBot/1.0 (+mailto:ops@example.com)

# 同一ホストへの最小アクセス間隔(ミリ秒。既定: 2000)。NFR-07 のため 2000 未満に下げない。
HOST_DELAY_MS=2000

# 異なるホスト間の並列数(既定: 4)。
HOST_CONCURRENCY=4

# HTTP タイムアウト(ミリ秒。既定: 20000)。
HTTP_TIMEOUT_MS=20000

# 1 ソースあたり 1 回の巡回で取り込む新規アイテムの上限(既定: 50)。
# 初回登録時の大量取り込みを防ぐための安全弁。
MAX_NEW_ITEMS_PER_SOURCE=50

# items.contentText として保存する本文の最大文字数(既定: 6000)。
MAX_CONTENT_CHARS=6000

# 監査データ(items / digests / deliveries / runs)の保持日数(既定: 90)。FR-16。
RETENTION_DAYS=90

# true なら LINE 送信と Slack 通知を行わず内容をログに出すだけにする(既定: false)。
# 本番ジョブでは必ず false。誤って true のまま運用すると配信が止まるので注意。
DRY_RUN=false

# -----------------------------------------------------------------------------
# 補助(任意。未設定でも動く)
# -----------------------------------------------------------------------------

# 設定ディレクトリ(既定: config)。コンテナ内も ./config に配置している。
# CONFIG_DIR=config

# ログ出力の下限レベル。debug | info | warn | error(既定: debug)。
# LOG_LEVEL=info
